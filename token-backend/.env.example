# Copy to .env and fill in. NEVER commit real secrets.

PORT=8787

# Shared secret guarding /credit and /box/open (your game server uses it; the
# public game client must NOT have it).
ADMIN_SECRET=change-me-to-a-long-random-string

# Solana RPC. Use devnet while testing.
SOLANA_RPC=https://api.devnet.solana.com

# Your $TOKEN SPL mint address (leave blank for dry-run payouts).
TOKEN_MINT=

# Treasury wallet secret key, base58 (the hot wallet that pays claims).
# Leave blank to run in DRY-RUN mode (no real transfers). Keep tiny + refill
# from a cold/multisig wallet. NEVER expose this.
TREASURY_SECRET=

# Max whole tokens a single wallet can withdraw per day (circuit breaker).
DAILY_WITHDRAW_CAP=1000

# Where the placeholder ledger file lives (replace with a real DB!).
LEDGER_PATH=./ledger.json
